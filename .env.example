APP_NAME=Fence Test API
APP_VERSION=1.0.0
DEBUG=false
LOG_LEVEL=INFO

# API Security
API_KEY_NAME=api_key
API_KEY_AUTH=your-secret-api-key-here

# Storage backend: postgres | smart_contract
STORAGE_BACKEND=postgres

# Server settings
HOST=0.0.0.0
PORT=8000

# PostgreSQL (used when STORAGE_BACKEND=postgres)
POSTGRES_SERVER=postgres
POSTGRES_USER=fence_user
POSTGRES_PASSWORD=fence_password
POSTGRES_DB=fence_test
POSTGRES_PORT=5432

# Blockchain (used when STORAGE_BACKEND=smart_contract)
BLOCKCHAIN_RPC_URL=http://hardhat-node:8545
HARDHAT_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
GAS_LIMIT=100000
